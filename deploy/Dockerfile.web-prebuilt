# The web app, compiled elsewhere: `next build` thrashes a server this small for over
# 15 minutes and slows the live site, so deploy/ship-web.sh builds locally and sends the output.
FROM node:22-slim
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY standalone/ ./
COPY static/ ./apps/web/.next/static/
COPY public/ ./apps/web/public/
USER node
CMD ["node", "apps/web/server.js"]
