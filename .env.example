# Copy to .env and fill in. Never commit real secrets.

# Postgres (docker-compose maps the container to host port 5433 by default)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://kisht:kisht@localhost:5433/kisht
TEST_DATABASE_URL=postgresql://kisht:kisht@localhost:5433/kisht_test

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-32-plus-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# API (Fastify)
API_HOST=0.0.0.0
API_PORT=4000

# Web (Next.js) – where /api/* is rewritten to
API_URL=http://localhost:4000
# Demo mode (D13): one-tap demo logins and a sample export download. Off in real deployments.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_PASSWORD=Kisht@Demo2026

# Seed: password for every demo account (local only; set a different one when hosting)
DEMO_PASSWORD=Kisht@Demo2026

# Optional: AI reminder drafts. Without a key, officers get the approved templates.
OPENROUTER_API_KEY=
# AI_DRAFT_MODELS=liquid/lfm-2.5-2.6b:free,openrouter/free

TZ=Asia/Kolkata
