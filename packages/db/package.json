{
  "name": "@kisht/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:test": "PRISMA_TARGET=test prisma migrate deploy",
    "seed": "tsx src/seed/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "dotenv": "18.0.9",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "@kisht/shared": "workspace:*"
  }
}
