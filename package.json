{
  "name": "kisht-collections",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "pnpm --filter @kisht/db generate",
    "dev": "pnpm -r --parallel --if-present dev",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @kisht/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @kisht/db migrate",
    "db:migrate:test": "pnpm --filter @kisht/db migrate:test",
    "db:seed": "pnpm --filter @kisht/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
